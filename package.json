{
  "name": "deepseek-coding-tools",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Kensan196948G/DeepSeek-Coding-Tools.git"
  },
  "description": "OpenCodeとOh My OpenCodeをDeepSeek専用・Workspace限定Sandboxで運用する開発基盤",
  "dependencies": {
    "oh-my-opencode": "4.19.4",
    "opencode-ai": "1.18.21"
  },
  "scripts": {
    "validate": "node scripts/validation/validate-config.mjs && node scripts/validation/validate-deepseek-runtime.mjs && node scripts/validation/validate-prompts.mjs && node scripts/validation/validate-migration.mjs && node scripts/validation/scan-secrets.mjs",
    "validate:deepseek": "node scripts/validation/validate-deepseek-runtime.mjs",
    "validate:config": "node scripts/validation/validate-config.mjs",
    "validate:prompts": "node scripts/validation/validate-prompts.mjs",
    "validate:migration": "node scripts/validation/validate-migration.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:sandbox": "node --test \"tests/sandbox/*.test.mjs\" \"tests/security/*.test.mjs\"",
    "webui": "node webui/server.mjs"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "js-yaml": "^4.1.0"
  }
}
