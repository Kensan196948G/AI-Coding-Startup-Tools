{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kensan196948G/DeepSeek-Coding-Tools/common/schemas/compatibility.schema.json",
  "title": "DeepSeek Coding Tools Compatibility",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "platforms", "dependencies", "tools"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "platforms": { "type": "object", "required": ["linux"], "additionalProperties": false,
      "properties": { "linux": { "type": "object", "required": ["distributions", "shells"] } } },
    "dependencies": { "type": "object", "required": ["git", "node", "bun", "bubblewrap"] },
    "tools": { "type": "object", "required": ["opencode", "orchestration", "provider"],
      "properties": {
        "opencode": { "type": "object", "required": ["package", "version"] },
        "orchestration": { "type": "object", "required": ["package", "upstreamName", "version"] },
        "provider": { "type": "object", "required": ["id", "mode"] }
      }
    }
  }
}
