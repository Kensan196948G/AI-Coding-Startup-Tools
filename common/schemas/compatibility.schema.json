{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kensan196948G/AI-Coding-Startup-Tools/common/schemas/compatibility.schema.json",
  "title": "Compatibility",
  "description": "互換性情報 YAML のスキーマ",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "platforms", "dependencies", "tools"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "platforms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["linux", "windows"],
      "properties": {
        "linux": {
          "type": "object",
          "required": ["distributions", "shells"],
          "properties": {
            "distributions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "versions"],
                "properties": {
                  "name": { "type": "string" },
                  "versions": { "type": "array", "items": { "type": "string" } }
                }
              }
            },
            "shells": {
              "type": "object",
              "properties": { "bash": { "type": "string" } }
            }
          }
        },
        "windows": {
          "type": "object",
          "required": ["versions", "powershell"],
          "properties": {
            "versions": { "type": "array", "items": { "type": "string" } },
            "powershell": { "type": "string" }
          }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "properties": {
        "git": { "type": "string" },
        "node": { "type": "string" }
      }
    },
    "tools": {
      "type": "object",
      "properties": {
        "claudeCode": {
          "type": "object",
          "required": ["policy"],
          "properties": {
            "policy": { "type": "string" },
            "note": { "type": "string" }
          }
        },
        "codex": {
          "type": "object",
          "required": ["policy"],
          "properties": {
            "policy": { "type": "string" },
            "note": { "type": "string" }
          }
        }
      }
    }
  }
}
