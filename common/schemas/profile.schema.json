{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kensan196948G/DeepSeek-Coding-Tools/common/schemas/profile.schema.json",
  "title": "Profile",
  "description": "AI ツール起動プロファイルのスキーマ",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "tool", "execution"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "tool": { "const": "opencode" },
    "platforms": {
      "type": "array",
      "items": { "const": "linux" },
      "minItems": 1,
      "uniqueItems": true
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvalMode"],
      "properties": {
        "approvalMode": { "enum": ["explicit", "none"] },
        "allowNetwork": { "type": "boolean" },
        "allowExternalWrite": { "type": "boolean" },
        "allowDestructive": { "type": "boolean" },
        "timeoutSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": { "type": "string" },
        "variables": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    }
  }
}
