# AI Coding Startup Tools WebUI 設定例 (Linux 側)

# 対話セッション (PTY 中継 /api/session) には python3 が必要です (Ubuntu LTS 標準搭載)

# 待受アドレス・ポート
# AI_WEBUI_HOST=127.0.0.1
# AI_WEBUI_PORT=8080

# アクセストークン (設定すると API は x-auth-token ヘッダー必須)
# 注意: ローカルループバック以外 (0.0.0.0 / LAN IP) で待受する場合は
# トークンの設定が必須です。未設定のまま起動するとサーバーが起動を拒否します (fail-closed)。
# AI_WEBUI_TOKEN=

# Codex セッションを全権限モード (--allow-dangerous / -Yolo) で起動可能にする場合のみ 1
# 既定は 0 (無効)。本番環境では原則 0 のまま運用してください。
# AI_WEBUI_ALLOW_DANGEROUS=0

# systemd OnFailure 用の障害通知 Webhook URL (任意)
# AI_ALERT_WEBHOOK_URL=

# API のレート制限 (1 IP あたり毎分のリクエスト数。既定 120)
# AI_WEBUI_RATE_LIMIT_PER_MINUTE=120

# 監査ログの出力先ディレクトリ (既定: .ai-startup-tools/logs)
# AI_WEBUI_LOG_DIR=/home/user/AI-Coding-Startup-Tools/.ai-startup-tools/logs

# リバースプロキシ配下で X-Forwarded-For を信頼する場合のみ 1 に設定
# AI_WEBUI_TRUST_PROXY=0

# Linux 側プロジェクトのルートフォルダ
# 複数指定する場合はカンマ区切り (WebUI 上でルートを選択して切り替えられる)
# AI_WEBUI_PROJECTS_ROOT_LINUX=/home/user/projects
# AI_WEBUI_PROJECTS_ROOT_LINUX=/home/user/Mirai-Project,/home/user/Mirai-DX-Project

# Windows 側 (Linux → Windows SSH 接続)
# AI_WEBUI_WINDOWS_HOST=192.168.0.143
# AI_WEBUI_WINDOWS_USER=user
# Windows 側も同様にカンマ区切りで複数ルートを指定できる
# AI_WEBUI_WINDOWS_PROJECTS_ROOT='C:\projects'
# AI_WEBUI_WINDOWS_PROJECTS_ROOT='D:\Mirai-Project,D:\Mirai-DX-Project'
# AI_WEBUI_WINDOWS_TOOLKIT_ROOT='D:\AI-Coding-Startup-Tools'
