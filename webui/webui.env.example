# DeepSeek Coding Tools WebUI
DEEPSEEK_WEBUI_HOST=127.0.0.1
DEEPSEEK_WEBUI_PORT=8080
DEEPSEEK_LOCAL_ROOTS=/srv/deepseek-workspaces
DEEPSEEK_SMB_ROOTS=/mnt/deepseek-smb
DEEPSEEK_AUDIT_LOG_DIR=/var/log/deepseek-coding-tools
# LAN公開時は長くランダムなtokenが必須です。実値はcommitしません。
# DEEPSEEK_WEBUI_TOKEN=
# リバースプロキシで送信元を検証済みの場合のみ有効化します。
# DEEPSEEK_WEBUI_TRUST_PROXY=0
