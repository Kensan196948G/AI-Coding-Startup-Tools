{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["oh-my-opencode@4.19.4"],
  "enabled_providers": ["deepseek"],
  "model": "deepseek/deepseek-v4-pro",
  "small_model": "deepseek/deepseek-v4-flash",
  "permission": {
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "id_rsa*": "deny",
      "id_ed25519*": "deny",
      "credentials*": "deny",
      "secrets*": "deny"
    },
    "edit": "ask",
    "bash": "ask",
    "task": "allow",
    "skill": "ask",
    "external_directory": "deny"
  }
}
