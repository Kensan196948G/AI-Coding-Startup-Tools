{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["oh-my-opencode@4.19.4"],
  "enabled_providers": ["deepseek"],
  "model": "deepseek/deepseek-v4-pro",
  "small_model": "deepseek/deepseek-v4-flash",
  "permission": {
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "id_rsa*": "deny",
      "id_ed25519*": "deny",
      "credentials*": "deny",
      "secrets*": "deny"
    },
    "edit": "allow",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch*": "allow",
      "npm test*": "allow",
      "npm run *": "allow",
      "pnpm test*": "allow",
      "pnpm run *": "allow",
      "node *": "allow",
      "python *": "allow",
      "python3 *": "allow",
      "pytest*": "allow",
      "go test*": "allow",
      "cargo test*": "allow",
      "make*": "allow",
      "cmake*": "allow",
      "sudo*": "deny",
      "su *": "deny",
      "mount*": "deny",
      "umount*": "deny",
      "systemctl*": "deny",
      "shutdown*": "deny",
      "reboot*": "deny",
      "mkfs*": "deny",
      "fdisk*": "deny",
      "iptables*": "deny",
      "nft*": "deny",
      "useradd*": "deny",
      "passwd*": "deny",
      "rm -rf /": "deny",
      "rm -rf /*": "deny"
    },
    "task": "allow",
    "skill": "ask",
    "external_directory": "deny"
  }
}
